# ---------------------------------------------------------------------------
# ProxID frontend. Copy to .env.local and fill in. Only VITE_ values reach the
# browser, so never put a secret in this file: everything here is public.
# ---------------------------------------------------------------------------

# Base URL of the ProxID API, including the version prefix.
# Local: the Vite dev server proxies /api to http://localhost:8000.
# Deployed: https://your-api-host/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Google OAuth client id for the "Continue with Google" button. This is the same
# value as GOOGLE_CLIENT_ID in the backend, and it is public by design.
# Get one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Base URL of the deployed frontend, used to build the agent card URL that the
# registry verifies against its registered value.
VITE_PUBLIC_APP_URL=http://localhost:5173

# Concordium network label shown next to anything chain-shaped. Display only: the
# backend decides the network.
VITE_CONCORDIUM_NETWORK=testnet

# Set to "true" to show the Judge Demo button. The backend must also have
# FEATURE_JUDGE_DEMO on, or the demo login answers that it is not enabled.
VITE_FEATURE_JUDGE_DEMO=true
