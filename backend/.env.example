# ---------------------------------------------------------------------------
# ProxID backend. Copy to .env and fill in.
#
# Only two values are required to boot (SECRET_KEY and DATABASE_URL). Everything
# else has a working default or makes an integration answer "not configured".
#
# The Concordium group is deliberately empty. No node endpoint, contract address,
# facilitator or merchant account has been issued, and this file does not invent
# one. The single exception is the testnet agent registry contract, which was
# given to us as verified.
# ---------------------------------------------------------------------------

# -- Application ------------------------------------------------------------

# development | test | production. Production disables /docs and the OpenAPI route.
APP_ENV=development
# Comma-separated origins allowed to call the API. Never "*": credentialed
# requests would be exposed to any site.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- Database ---------------------------------------------------------------

# Async SQLAlchemy URL. Local Postgres with PostGIS:
#   docker compose up -d db
# On Neon or Supabase use the pooled connection string with the driver rewritten
# to postgresql+asyncpg. Get it from the project's "Connection string" panel.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/proxid
# Log every statement. Useful locally, never in production.
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10

# -- Session security -------------------------------------------------------

# Signing key for session tokens. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value; rotate it to invalidate every session at once.
SECRET_KEY=
SESSION_TOKEN_TTL_HOURS=168
SESSION_COOKIE_NAME=proxid_session
# Set true in production, where the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# -- Google OAuth -----------------------------------------------------------

# OAuth 2.0 Web client id. console.cloud.google.com > APIs and Services >
# Credentials > Create credentials > OAuth client ID > Web application.
# The same value goes in frontend/.env.example as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# The client secret is not used by the access-token flow, but keep it here for the
# authorization-code flow if that is added later. Same console page.
GOOGLE_CLIENT_SECRET=
# Where an access token is checked, and its audience compared to the client id.
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo

# -- Groq (the agent's language model) --------------------------------------

# One key: console.groq.com > API Keys. Leave empty and the agent degrades to a
# rule-based answer that says the model is not connected.
GROQ_API_KEY=
# Several keys, comma-separated, rotated on a rate limit. Wins over GROQ_API_KEY.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_TOKENS=900

# -- Cloudinary (job photos and avatars) ------------------------------------

# cloudinary.com > Console > Dashboard: cloud name, API key, API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=proxid

# -- Brevo (transactional email) --------------------------------------------

# app.brevo.com > SMTP and API > API keys. The sender must be a verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ProxID
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# -- Map tiles --------------------------------------------------------------

# Free OpenStreetMap raster tiles. No key, no billing. Attribution must stay.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=OpenStreetMap contributors

# -- Concordium (not configured: nothing below is issued) -------------------

# testnet | mainnet.
CONCORDIUM_NETWORK=testnet
# gRPC node endpoint, host:port. NOT SET: no endpoint has been issued. An empty
# value is what makes identity anchoring and agent registration refuse to run.
CONCORDIUM_NODE_ENDPOINT=
# Agent registry contract. 12802,0 is the verified testnet contract and is the
# only address in this file, because it was given to us rather than guessed.
CONCORDIUM_AGENT_REGISTRY_ADDRESS=12802,0
# Identity and revocation registry contract. NOT SET.
CONCORDIUM_IDENTITY_CONTRACT_ADDRESS=
# CAIP-2 network id used by x402, read from @x402/concordium's own constants.
CONCORDIUM_CAIP2_NETWORK=ccd:4221332d34e1694168c2a0c0b3fd0f27
# Account that receives x402 payments. NOT SET.
CONCORDIUM_X402_MERCHANT_ACCOUNT=
CONCORDIUM_REQUEST_TIMEOUT_SECONDS=15

# -- Veriox (Verify and Access: the ZKP personhood flow) --------------------

# Veriox handles QR generation, chain anchoring and a true/false answer.
# demo.veriox.io was inspected on 21 Nov 2026: it serves an age-gated storefront
# and publishes no API schema. The two paths below therefore have no defaults.
# Get them from the Veriox integration guide and the API key from Veriox.
VERIOX_BASE_URL=
VERIOX_API_KEY=
VERIOX_REQUEST_PATH=
VERIOX_STATUS_PATH=
# The domain a verification request is bound to. A proof for one domain must not
# unlock another, so this must be the deploying site's own host.
VERIOX_BOUND_DOMAIN=localhost
# How long a request stays valid. Single use, always.
VERIOX_REQUEST_TTL_SECONDS=300

# -- Agent IDP (delegated agent identity) ------------------------------------

# Concordium's Agent IDP issues a scoped credential to an agent after the human
# reveals one attribute with a ZKP. DevNet only, so this stays empty.
CONCORDIUM_AGENT_IDP_URL=

# -- x402 -------------------------------------------------------------------

# The real package is @x402/concordium (verified on npm, v2.32.0). It ships
# Client, Server and Facilitator; we write none of them and call the packaged
# Server through a small Node bridge.
X402_BRIDGE_URL=
# The facilitator this deployment trusts to verify and sponsor gas. NOT SET.
X402_FACILITATOR_URL=
# CCD has 6 decimals. A PLT token id such as USDR also works here.
X402_ASSET=CCD
X402_ASSET_DECIMALS=6
# The package rejects a transaction expiry further out than this (its rule 7).
X402_MAX_EXPIRY_OFFSET_SECONDS=600
# The package waits this long for ConcordiumBFT finalisation (~10s finality).
X402_FINALIZATION_TIMEOUT_SECONDS=60

# -- Agent spending safety --------------------------------------------------

# Protocol-level account locks are DevNet only, so the agent is confined by these
# client-side limits against its own low-balance account. They are written to
# swap into protocol locks without changing a call site.
AGENT_SPEND_PER_PAYMENT_LIMIT=5000
AGENT_SPEND_DAILY_LIMIT=20000
# Comma-separated payee addresses the agent may ever pay. Empty means nobody:
# an allowlist is deny-by-default on purpose.
AGENT_RECIPIENT_ALLOWLIST=
AGENT_REQUIRES_HUMAN_APPROVAL=true

# -- Resilience -------------------------------------------------------------

# One circuit breaker per outbound dependency: Groq, Google, Cloudinary, Brevo,
# Concordium. These are the defaults for every one of them.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=30
BREAKER_HALF_OPEN_PROBES=1
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_BASE_SECONDS=0.25
OUTBOUND_BULKHEAD_LIMIT=8

# -- Rate limits (requests per minute) --------------------------------------

# Always on. Never behind a feature flag: a flag that can disable a limit is a
# backdoor with a nice name.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# -- Feature flags ----------------------------------------------------------
# Every flag is declared in core/config.py with the date it was added and the
# condition for removing it. These are the current values.

# True only when every Concordium value above is set. Until then the identity,
# registry and anchor paths answer "not configured" and attempt no network call.
FEATURE_CONCORDIUM_LIVE=false
# x402 settlement. False until a bridge, a facilitator and a merchant exist.
FEATURE_X402_PAYMENTS=false
# The Veriox identity adapter. False until the paths and key arrive.
FEATURE_VERIOX_IDENTITY=false
# Agent IDP delegated identity. False while it is DevNet only.
FEATURE_AGENT_IDP=false
# The judge demo: one click into the seeded profile. Safe to leave on.
FEATURE_JUDGE_DEMO=true
# The agent's tool-calling loop.
FEATURE_AGENT_TOOLS=true
# Brevo delivery. False until a verified sender exists.
FEATURE_EMAIL_DELIVERY=false
# Cloudinary uploads. False until credentials exist.
FEATURE_MEDIA_UPLOAD=false
